# Fill after deploy (see scripts/deploy-testnet.sh or deploy-mainnet.sh)

NEXT_PUBLIC_PACKAGE_ID=0xYOUR_PACKAGE_ID
NEXT_PUBLIC_VAULT_ID=0xYOUR_SHARED_VAULT_OBJECT_ID
NEXT_PUBLIC_ADMIN_CAP_ID=0xYOUR_ADMIN_CAP_OBJECT_ID
NEXT_PUBLIC_COIN_TYPE=0x2::sui::SUI
NEXT_PUBLIC_PYTH_SUI_FEED_ID=
# Optional override. Leave empty to auto-pick by network.

# Smart Save: 8500 = 85% vault, 15% liquid buffer (basis points)
NEXT_PUBLIC_SMART_SAVE_VAULT_BPS=8500

# --- Priority 1: Real yield (mainnet only) ---
# NAVI lending composability — requires mainnet wallet + SUI
NEXT_PUBLIC_ENABLE_NAVI=false
NEXT_PUBLIC_SUI_NETWORK=testnet

# --- Priority 2: Auto ShieldScore from Pyth ---
# Client polls keeper API every 5 min when true
NEXT_PUBLIC_AUTO_SHIELD_KEEPER=false

# Server-only (Vercel env, NOT NEXT_PUBLIC):
# KEEPER_PRIVATE_KEY=suiprivkey...   # deployer/admin key with AdminCap
# CRON_SECRET=random-string          # optional auth for /api/keeper/sync
# KEEPER_PYTH_REF_USD=3.65           # optional initial Pyth reference price
